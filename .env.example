# Copy to .env and adjust. `pnpm dev` reads it; so does `docker compose`.

DATABASE_URL=postgres://strekatron:strekatron@localhost:5432/strekatron

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-0123456789

# Every origin the app is opened at, comma-separated; add your tailnet URL, e.g.
# https://my-laptop.tail1234.ts.net
APP_ORIGINS=http://localhost:5173,http://localhost:3001

# Backups run `pg_dump`. Without it installed on the host, use the one in the database container:
PG_DUMP="docker exec -i strekatron-db pg_dump"

# Set to false to run the server without background jobs.
# JOBS_ENABLED=true

# Used by `pnpm db:seed` for the dev account.
# SEED_EMAIL=dev@strekatron.local
# SEED_PASSWORD=strekatron-dev
