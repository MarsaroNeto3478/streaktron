{
  "name": "@strekatron/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@strekatron/shared": "workspace:*",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
